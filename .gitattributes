# This repo is developed from WSL against a Windows-mounted path, where editors and
# packaging tools silently rewrite whole files to CRLF and drown real diffs in noise.
# Pin LF in the worktree so that cannot recur; binaries are still auto-detected.
* text=auto eol=lf

# Browser bundles produced by scripts/build-client.mjs.
/packages/report-review/lib/** linguist-generated=true
# Vendor Markdown serializers contain meaningful trailing spaces in literals.
/packages/report-review/lib/client.js whitespace=-blank-at-eol,-space-before-tab

# Dependency metadata generated by npm.
/package-lock.json linguist-generated=true

# Other lib directories contain maintained source; do not mark lib/** globally.

# Preserve upstream license files verbatim, including final blank lines.
/third_party/licenses/** whitespace=-blank-at-eof
